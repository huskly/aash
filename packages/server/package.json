{
  "name": "@aave-monitor/server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx --tsconfig tsconfig.test.json --test test/**/*.test.ts",
    "morpho:market-env": "tsx src/scripts/morphoMarketEnv.ts",
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aave-monitor/core": "*",
    "@bgd-labs/aave-address-book": "^4.44.22",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
