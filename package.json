{
  "name": "aave-loan-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": false
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "yarn tsc --noEmit -p tsconfig.app.json && yarn tsc --noEmit -p tsconfig.node.json && yarn workspace @aave-monitor/core typecheck && yarn workspace @aave-monitor/server typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "yarn workspace @aave-monitor/server dev",
    "dev:all": "yarn dev & yarn dev:server",
    "build:server": "yarn workspace @aave-monitor/server build",
    "morpho:market-env": "yarn workspace @aave-monitor/server morpho:market-env",
    "test": "yarn workspace @aave-monitor/server test",
    "test:contracts": "forge test --root packages/rescue-contract",
    "deploy:rescue:dry-run": "cd packages/rescue-contract && forge script script/DeployAaveAtomicRepayV1.s.sol:DeployAaveAtomicRepayV1",
    "deploy:vault-withdraw:dry-run": "cd packages/rescue-contract && forge script script/DeployMorphoVaultWithdrawV1.s.sol:DeployMorphoVaultWithdrawV1"
  },
  "dependencies": {
    "@aave-monitor/core": "*",
    "@radix-ui/react-slider": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
